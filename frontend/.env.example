# ---------------------------------------------------------------------------
# Industrial FireWatch — frontend environment
# Copy to `.env` and adjust. All values are optional; the defaults assume the
# FastAPI backend is running locally on port 8000.
# ---------------------------------------------------------------------------

# Where the Vite dev server proxies /api requests (dev only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute backend origin. Leave empty in development so requests stay relative
# and flow through the dev proxy above. Set it for preview/production builds,
# e.g. VITE_API_BASE_URL=https://firewatch-api.example.com
VITE_API_BASE_URL=

# Optional tile provider overrides (see docs/DECISIONS.md).
VITE_MAP_STYLE_URL=
VITE_SATELLITE_TILE_URL=
VITE_NASA_GIBS_URL=
